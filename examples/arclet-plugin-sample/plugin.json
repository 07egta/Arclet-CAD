{
  "id": "org.arclet.sample",
  "version": "1.0.0",
  "api_version": "1.0",
  "executable": "arclet-sample-plugin",
  "permissions": [
    "model_read",
    "model_edit"
  ],
  "commands": [
    {
      "name": "box",
      "description": "Create a cube via the Arclet command engine",
      "input_schema": {
        "type": "object",
        "properties": {
          "size_mm": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "size_mm"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "size_mm": {
            "type": "number"
          }
        },
        "required": [
          "size_mm"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "report",
      "description": "Read body count and volume without modifying the model",
      "input_schema": {
        "type": "object",
        "properties": {
          "fail": {
            "type": "boolean"
          },
          "try_forbidden": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "body_count": {
            "type": "integer"
          },
          "volume_mm3": {
            "type": "number"
          }
        },
        "required": [
          "body_count",
          "volume_mm3"
        ],
        "additionalProperties": false
      }
    }
  ]
}
