-    centre = (lo + hi) * 0.5
-    cell = np.clip(((centre - origin) / span * grid).astype(np.int64),
-                   0, grid - 1)
-    key = (cell[:, 0] * grid + cell[:, 1]) * grid + cell[:, 2]
-
+    key = np.zeros(n, np.int32)
+    for axis in range(3):
+        coord = ((lo[:, axis] + hi[:, axis]) * 0.5).astype(np.float64)
+        coord -= origin[axis]
