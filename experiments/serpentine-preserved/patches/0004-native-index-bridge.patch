index 0000000..e5e4f1d
--- /dev/null
+++ b/serpentine3d/core/native_spatial.py
@@ -0,0 +1,121 @@
+"""Optional Rust chunk index; a missing accelerator keeps the NumPy path.
+
+Only native-endian, aligned, C-contiguous float32/uint32 triples are borrowed.
+No input is mutated. PyDLL retains the GIL while Rust reads the arrays, and
+output arrays are copied before the foreign owner is freed. This bridge is
+not a security boundary for arbitrarily corrupted native memory.
+"""
+from __future__ import annotations
+
+import ctypes as C
+from functools import lru_cache
+import os
+from pathlib import Path
+import sys
+
+import numpy as np
+
+
+class _View(C.Structure):
+    _fields_ = [('order', C.POINTER(C.c_int32)),
+                ('starts', C.POINTER(C.c_int64)),
+                ('mins', C.POINTER(C.c_double)),
+                ('maxs', C.POINTER(C.c_double)),
+                ('primitives', C.c_size_t), ('chunks', C.c_size_t)]
+
+
+@lru_cache(maxsize=1)
+def _load():
+    names = {'win32': 'serpentine_pick_index.dll',
+             'darwin': 'libserpentine_pick_index.dylib',
+             'linux': 'libserpentine_pick_index.so'}
+    name = names.get(sys.platform)
+    if name is None:
+        return None, 'unsupported operating system'
+    path = Path(__file__).resolve().parents[1] / '_native' / name
+    if not path.is_file():
+        return None, 'optional library not installed'
+    try:
+        lib = C.PyDLL(str(path))
+        lib.serp_pick_abi_version.argtypes = []
+        lib.serp_pick_abi_version.restype = C.c_uint32
+        if lib.serp_pick_abi_version() != 1:
+            return None, 'incompatible native index ABI'
+        lib.serp_pick_build_f32.argtypes = [C.POINTER(C.c_float), C.c_size_t,
+                                          C.POINTER(C.c_uint32), C.c_size_t,
+                                          C.c_uint32, C.POINTER(C.c_void_p)]
+        lib.serp_pick_build_f32.restype = C.c_int
+        lib.serp_pick_view.argtypes = [C.c_void_p, C.POINTER(_View)]
+        lib.serp_pick_view.restype = C.c_int
+        lib.serp_pick_free.argtypes = [C.c_void_p]
+        lib.serp_pick_free.restype = None
+        return lib, None
+    except (OSError, AttributeError) as exc:
+        return None, str(exc)
+
+
+def backend_status() -> dict:
+    lib, error = _load()
+    return {'available': lib is not None, 'abi': 1 if lib is not None else None,
+            'reason': error, 'requested': os.environ.get('SERP3D_PICK_BACKEND', 'auto')}
+
+
+def native_triangle_index(vertices: np.ndarray, triangles: np.ndarray,
+                          grid: int) -> tuple | None:
+    """Return owned (order, starts, mins, maxs) arrays, or use NumPy instead.
+
+    SERP3D_PICK_BACKEND=python disables acceleration. `rust` requires the
+    library, so CI cannot accidentally benchmark the fallback as native code.
+    Other dtypes/layouts and unsupported nonfinite midpoints retain the
+    original NumPy behaviour, even when the library is required.
+    """
+    mode = os.environ.get('SERP3D_PICK_BACKEND', 'auto')
+    if mode not in ('auto', 'python', 'rust'):
+        raise ValueError('SERP3D_PICK_BACKEND must be auto, python, or rust')
+    if mode == 'python':
+        return None
+    if (not isinstance(vertices, np.ndarray) or not isinstance(triangles, np.ndarray)
+            or vertices.dtype != np.dtype(np.float32)
+            or triangles.dtype != np.dtype(np.uint32)
+            or vertices.ndim != 2 or vertices.shape[1] != 3
+            or triangles.ndim != 2 or triangles.shape[1] != 3
+            or not vertices.flags.c_contiguous or not triangles.flags.c_contiguous
+            or not vertices.flags.aligned or not triangles.flags.aligned
+            or not 0 < len(triangles) <= np.iinfo(np.int32).max):
+        return None
+    if not 1 <= grid <= 64:
+        raise ValueError('Native chunk grid must be in the range 1..64')
+    lib, error = _load()
+    if lib is None:
+        if mode == 'rust':
+            raise RuntimeError(f'Rust pick index required but unavailable: {error}')
+        return None
+    handle = C.c_void_p()
+    code = lib.serp_pick_build_f32(vertices.ctypes.data_as(C.POINTER(C.c_float)),
+                                   len(vertices),
+                                   triangles.ctypes.data_as(C.POINTER(C.c_uint32)),
+                                   len(triangles), grid, C.byref(handle))
+    try:
+        if code == 3:
+            return None                    # preserve the existing unusual-input path
+        if code == 2:
+            raise IndexError('Triangle references a vertex outside the mesh')
+        if code == 4:
+            raise MemoryError('Native chunk index allocation was refused')
+        if code or not handle.value:
+            raise RuntimeError(f'Native chunk index failed with status {code}')
+        view = _View()
+        if lib.serp_pick_view(handle, C.byref(view)) != 0:
+            raise RuntimeError('Cannot obtain native chunk index arrays')
+        if view.primitives != len(triangles) or not 0 < view.chunks <= min(grid ** 3, len(triangles)):
+            raise RuntimeError('Native chunk index returned invalid dimensions')
+        if not all((view.order, view.starts, view.mins, view.maxs)):
+            raise RuntimeError('Native chunk index returned a null array')
+        order = np.ctypeslib.as_array(view.order, shape=(view.primitives,)).copy()
+        starts = np.ctypeslib.as_array(view.starts, shape=(view.chunks + 1,)).copy()
+        mins = np.ctypeslib.as_array(view.mins, shape=(view.chunks * 3,)).reshape(-1, 3).copy()
+        maxs = np.ctypeslib.as_array(view.maxs, shape=(view.chunks * 3,)).reshape(-1, 3).copy()
+        return order, starts, mins, maxs
+    finally:
+        if handle.value:
+            lib.serp_pick_free(handle)
